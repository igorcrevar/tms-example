NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Per-IP rate limit. RATE_LIMIT_DISABLED is a test seam, ignored in production.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
RATE_LIMIT_DISABLED=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tms
DB_PASSWORD=
DB_NAME=tms
DB_LOGGING=false

# Auth — one secret per token family. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required at boot, minimum 32 characters, no defaults. Never reuse across families.
JWT_STAFF_ACCESS_SECRET=
JWT_STAFF_REFRESH_SECRET=
JWT_DRIVER_ACCESS_SECRET=
JWT_DRIVER_REFRESH_SECRET=

JWT_STAFF_ACCESS_TTL=10m
JWT_STAFF_REFRESH_TTL=7d
JWT_DRIVER_ACCESS_TTL=10m
JWT_DRIVER_REFRESH_TTL=30d
MFA_CHALLENGE_TTL=5m
# Longer on first sign-in: scanning the QR and opening an authenticator takes a while.
MFA_ENROLMENT_TTL=15m

# Cookies. AUTH_COOKIE_SECURE=false is only acceptable on plain-http localhost.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict

# Brute-force protection
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MS=900000

# TOTP
TOTP_ISSUER=TMS
TOTP_WINDOW=1

# Super admin seed — read by `npm run seed` only, never by the running API.
# The seed refuses to run with a short or placeholder password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Winston file logging
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# Mail. Production refuses to boot without MAIL_HOST so an invitation cannot be
# silently dropped. In development, leaving it blank writes .eml files to MAIL_DEV_DIR.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=TMS <no-reply@tms.local>
MAIL_DEV_DIR=./storage/dev-mail

# Invitations
INVITATION_TTL=7d
INVITATION_ACCEPT_URL=http://localhost:5173/admin/accept-invite

# Password reset. Much shorter than an invitation: the account already exists.
PASSWORD_RESET_TTL=1h
PASSWORD_RESET_URL=http://localhost:5173/admin/reset-password
